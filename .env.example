# Local prototype configuration. Keep the API bound to loopback in development.
LIBERO_ENV=development
MCP_HOST=127.0.0.1
MCP_PORT=8080

# Optional speech transcription and model providers.
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
LIBERO_LLM_PROVIDER=auto
LIBERO_DEFAULT_LANGUAGE=en
LIBERO_SPEECH_LANGUAGE=auto
# Optional PortAudio input device index or exact device name from:
# python scripts/diagnostico_audio.py
# LIBERO_AUDIO_INPUT_DEVICE=4
AWS_REGION=us-east-2
# Set only if Bedrock is configured in your AWS account. Use AWS CLI/profile or
# another standard AWS credential provider; do not put access keys in this file.
BEDROCK_MODEL_ID=
POLLY_VOICE=Camila
POLLY_LANGUAGE=pt-BR
POLLY_VOICE_PT=Camila
POLLY_VOICE_EN=Joanna
# Optional local voice models. The built-in defaults are Portuguese Faber and
# English Lessac under ~/libero/models/piper/.
# PIPER_MODEL_PT=~/libero/models/piper/pt_BR-faber-medium.onnx
# PIPER_MODEL_EN=~/libero/models/piper/en_US-lessac-medium.onnx

# Camera starts only when explicit consent is set to true.
LIBERO_CAMERA_CONSENT=false

# Local edge camera/status service. Browser origins are explicit, not wildcarded.
LIBERO_EDGE_HOST=127.0.0.1
LIBERO_EDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
