{
  "name": "libero-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:all && python3 -m http.server 3000 --directory ../interface/web",
    "build": "vite build",
    "build:avatar": "vite build --config vite.config.js",
    "build:app": "vite build --config vite.app.config.js",
    "build:all": "npm run build:avatar && npm run build:app",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.10"
  }
}
